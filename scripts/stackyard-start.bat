@echo off
rem Starts Apache (+PHP) and MySQL from Stackyard for the project this file is placed in.
rem Copy it into a Laravel project root (next to artisan); DocumentRoot = <project>\public.
rem Uses the configs generated by Stackyard, so start Apache and MySQL in Stackyard once first.
rem Override ports for one run with e.g.:  set HTTP_PORT=8080 & stackyard-start.bat
setlocal EnableExtensions

if not defined HTTP_PORT set "HTTP_PORT=8000"
if not defined MYSQL_PORT set "MYSQL_PORT=3306"

for %%X in (httpd.exe mysqld.exe mysqladmin.exe) do (
    where %%X >nul 2>nul || (echo %%X not found in PATH - add Apache and MySQL to PATH in Stackyard. & exit /b 1)
)

rem Stackyard folder = 4 levels above the first httpd.exe in PATH (<root>\bin\apache\<version>\bin\),
rem so the script keeps working after Stackyard is moved. Set STACK beforehand to override.
if not defined STACK for /f "delims=" %%H in ('where httpd.exe') do if not defined STACK for %%R in ("%%~dpH..\..\..\..") do set "STACK=%%~fR"
if not exist "%STACK%\config\apache\httpd.conf" (echo No Stackyard configs in "%STACK%" - start Apache and MySQL in Stackyard once, or set STACK. & exit /b 1)

for %%I in ("%~dp0.") do set "NAME=%%~nxI"
set "DOCROOT=%~dp0public"
if not exist "%DOCROOT%\" set "DOCROOT=%~dp0."
set "DOCROOT_FWD=%DOCROOT:\=/%"
set "STACK_FWD=%STACK:\=/%"
set "CONF=%STACK%\tmp\httpd-%NAME%.conf"
set "PIDFILE=%STACK%\tmp\httpd-%NAME%.pid"

rem Copy of Stackyard's httpd.conf with our port, document root and pid file (UTF-8 without BOM).
powershell -NoProfile -Command "$c = [IO.File]::ReadAllText('%STACK%\config\apache\httpd.conf'); $c = $c -replace '(?m)^Listen \d+', 'Listen %HTTP_PORT%' -replace '(?m)^ServerName .*', 'ServerName localhost:%HTTP_PORT%' -replace [regex]::Escape('%STACK_FWD%/www'), '%DOCROOT_FWD%' -replace 'httpd\.pid', 'httpd-%NAME%.pid'; [IO.File]::WriteAllText('%CONF%', $c)"
if errorlevel 1 exit /b 1

netstat -ano | findstr /R /C:":%HTTP_PORT% .*LISTENING" >nul
if not errorlevel 1 (echo Port %HTTP_PORT% is already in use. Run with another one: set HTTP_PORT=8080 ^& %~nx0 & exit /b 1)

set "OWN_MYSQL="
netstat -ano | findstr /R /C:":%MYSQL_PORT% .*LISTENING" >nul
if errorlevel 1 (
    set "OWN_MYSQL=1"
    start "" /b mysqld --defaults-file="%STACK%\config\mysql\my.ini" --port=%MYSQL_PORT%
) else (
    echo Something already listens on port %MYSQL_PORT% - using that MySQL.
)

start "" /b httpd -f "%CONF%"

echo.
echo   %NAME%:  http://localhost:%HTTP_PORT%/
echo   MySQL:   127.0.0.1:%MYSQL_PORT%  (user root, no password)
echo   Logs:    %STACK%\logs
echo.
echo Press any key to stop...
pause >nul

echo Stopping...
rem Find our httpd processes by their config path (works even before the pid file exists).
powershell -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='httpd.exe'\" | Where-Object { $_.CommandLine -like '*httpd-%NAME%.conf*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"
if defined OWN_MYSQL mysqladmin --user=root --host=127.0.0.1 --port=%MYSQL_PORT% shutdown 2>nul
del "%CONF%" "%PIDFILE%" 2>nul
echo Done.
